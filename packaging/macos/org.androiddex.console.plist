<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>org.androiddex.console</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/opt/android-dex/server/src/index.js</string>
    <string>serve</string>
    <string>--host</string><string>127.0.0.1</string>
    <string>--port</string><string>8787</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>DEX_DATA_DIR</key><string>/Users/Shared/android-dex/data</string>
    <key>DEX_SHARE_DIR</key><string>/Users/Shared/android-dex/share</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict><key>SuccessfulExit</key><false/></dict>
  <key>StandardOutPath</key><string>/Users/Shared/android-dex/bridge.log</string>
  <key>StandardErrorPath</key><string>/Users/Shared/android-dex/bridge.err.log</string>
  <key>ProcessType</key><string>Interactive</string>
</dict>
</plist>
